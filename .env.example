# Copy to .env and fill in. Never commit .env.

# Database
POSTGRES_USER=labrasa
POSTGRES_PASSWORD=change-me
POSTGRES_DB=labrasa
DATABASE_URL=postgresql://labrasa:change-me@db:5432/labrasa

# Backend log level: DEBUG, INFO (default), WARNING, ERROR. Read with: docker compose logs -f backend
LOG_LEVEL=INFO

# NASA FIRMS (only needed for data updates)
# Free key: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# Meteomatics (cloud cover at the satellite overpasses, pipeline/ingestion/fetch_clouds.py)
METEOMATICS_USERNAME=
METEOMATICS_PASSWORD=
