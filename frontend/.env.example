# Copy to .env.local. Everything here is bundled into the client – never put secrets here.

# Backend origin; empty = same origin (/api via Vite proxy or Caddy)
VITE_API_URL=

# Optional: another MapLibre style URL for the basemap
VITE_BASEMAP_STYLE_URL=

# Optional: raster tiles for the satellite view ({z}/{y}/{x} template) and their attribution
VITE_SATELLITE_TILES_URL=
VITE_SATELLITE_ATTRIBUTION=
